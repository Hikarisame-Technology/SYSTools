<Page x:Class="SYSTools.WindowsToolsPages.WindowsUtilities"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:muxc="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:model="clr-namespace:SYSTools.Model"
      xmlns:local="clr-namespace:SYSTools.WindowsToolsPages"
      mc:Ignorable="d" 
      d:DesignWidth="1040" d:DesignHeight="560"
      KeepAlive="True"
      Title="WindowsUtilities" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  MinWidth="1040" MinHeight="560">

    <Page.Resources>
        <!-- 带图标的工具按钮样式 -->
        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="130"/>
            <Setter Property="Height" Value="68"/>
            <Setter Property="Margin" Value="4,0,4,8"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 带图标切换按钮样式 -->
        <Style x:Key="ToolToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="130"/>
            <Setter Property="Height" Value="68"/>
            <Setter Property="Margin" Value="4,0,4,8"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 带图标和文字的按钮内容模板 -->
        <Style x:Key="ToolButtonContent" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border BorderThickness="1" CornerRadius="5" Grid.RowSpan="3" Grid.ColumnSpan="2"/>
        <Image x:Name="image" HorizontalAlignment="Right" VerticalAlignment="Bottom" Grid.Column="1" Grid.Row="3"
               Source="/SYSTools;component/Resources/LOGO.png" Opacity="0.5" Width="160" Height="90"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="5,5,20,10">

                <!-- ═══════════════════════ 快捷启动 ═══════════════════════ -->
                <Expander Header="{model:Resource Key=WinUtil_QuickLaunch}" IsExpanded="True" FontSize="17"
                          Style="{StaticResource {x:Static muxc:ThemeKeys.ExpanderCardStyleKey}}"
                          Margin="0,0,0,10" Padding="0">
                    <Expander.Content>
                        <WrapPanel Margin="8,10,8,4">
                            <Button x:Name="CMD" Style="{StaticResource ToolButtonStyle}" Click="CMD_Click"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE756;" FontFamily="{DynamicResource SegoeIcons}" FontSize="24"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{model:Resource Key=WinUtil_CMD}" FontSize="12" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="PowerShell" Style="{StaticResource ToolButtonStyle}" Click="PowerShell_Click"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE756;" FontFamily="{DynamicResource SegoeIcons}" FontSize="24"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{model:Resource Key=WinUtil_PowerShell}" FontSize="12" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="Regedit" Style="{StaticResource ToolButtonStyle}" Click="Regedit_Click"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8D9;" FontFamily="{DynamicResource SegoeIcons}" FontSize="24"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{model:Resource Key=WinUtil_Regedit}" FontSize="12" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="Control" Style="{StaticResource ToolButtonStyle}" Click="Control_Click"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE713;" FontFamily="{DynamicResource SegoeIcons}" FontSize="24"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{model:Resource Key=WinUtil_ControlPanel}" FontSize="12" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="compmgmt" Style="{StaticResource ToolButtonStyle}" Click="compmgmt_Click"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE977;" FontFamily="{DynamicResource SegoeIcons}" FontSize="24"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{model:Resource Key=WinUtil_ComputerMgmt}" FontSize="12" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="Eventvwr" Style="{StaticResource ToolButtonStyle}" Click="Eventvwr_Click"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE96B;" FontFamily="{DynamicResource SegoeIcons}" FontSize="24"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{model:Resource Key=WinUtil_EventViewer}" FontSize="12" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="Devmgmt" Style="{StaticResource ToolButtonStyle}" Click="Devmgmt_Click"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE72E;" FontFamily="{DynamicResource SegoeIcons}" FontSize="24"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{model:Resource Key=WinUtil_DeviceMgr}" FontSize="12" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="Gpedit" Style="{StaticResource ToolButtonStyle}" Click="Gpedit_Click"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xEAAB;" FontFamily="{DynamicResource SegoeIcons}" FontSize="24"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{model:Resource Key=WinUtil_GPEdit}" FontSize="12" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="Taskschd" Style="{StaticResource ToolButtonStyle}" Click="Taskschd_Click"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE923;" FontFamily="{DynamicResource SegoeIcons}" FontSize="24"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{model:Resource Key=WinUtil_TaskScheduler}" FontSize="12" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="GodMode" Style="{StaticResource ToolButtonStyle}" Click="GodMode_Click"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE735;" FontFamily="{DynamicResource SegoeIcons}" FontSize="24"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{model:Resource Key=WinUtil_GodMode}" FontSize="12" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="Winver" Style="{StaticResource ToolButtonStyle}" Click="Winver_Click"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xF4A5;" FontFamily="{DynamicResource SegoeIcons}" FontSize="24"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{model:Resource Key=WinUtil_WinVer}" FontSize="12" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="SystemProperties" Style="{StaticResource ToolButtonStyle}" Click="SystemProperties_Click"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE946;" FontFamily="{DynamicResource SegoeIcons}" FontSize="24"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{model:Resource Key=WinUtil_SystemProps}" FontSize="12" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="PerfMon" Style="{StaticResource ToolButtonStyle}" Click="PerfMon_Click"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xEDA6;" FontFamily="{DynamicResource SegoeIcons}" FontSize="24"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{model:Resource Key=WinUtil_PerfMon}" FontSize="12" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ResMon" Style="{StaticResource ToolButtonStyle}" Click="ResMon_Click"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE950;" FontFamily="{DynamicResource SegoeIcons}" FontSize="24"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{model:Resource Key=WinUtil_ResMon}" FontSize="12" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="TaskMgr" Style="{StaticResource ToolButtonStyle}" Click="TaskMgr_Click"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE85F;" FontFamily="{DynamicResource SegoeIcons}" FontSize="24"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{model:Resource Key=WinUtil_TaskMgr}" FontSize="12" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="MSConfig" Style="{StaticResource ToolButtonStyle}" Click="MSConfig_Click"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE713;" FontFamily="{DynamicResource SegoeIcons}" FontSize="24"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{model:Resource Key=WinUtil_MSConfig}" FontSize="12" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="DisplaySettings" Style="{StaticResource ToolButtonStyle}" Click="DisplaySettings_Click"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE7F4;" FontFamily="{DynamicResource SegoeIcons}" FontSize="24"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{model:Resource Key=WinUtil_DisplaySettings}" FontSize="12" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="Explorer_Restart" Style="{StaticResource ToolButtonStyle}" Click="Explorer_Restart_Click"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE777;" FontFamily="{DynamicResource SegoeIcons}" FontSize="24"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{model:Resource Key=WinUtil_RestartExplorer}" FontSize="12" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Expander.Content>
                </Expander>

                <!-- ═══════════════════════ 网络工具 ═══════════════════════ -->
                <Expander Header="{model:Resource Key=WinUtil_NetworkTools}" IsExpanded="True" FontSize="17"
                          Style="{StaticResource {x:Static muxc:ThemeKeys.ExpanderCardStyleKey}}"
                          Margin="0,0,0,10" Padding="0">
                    <Expander.Content>
                        <WrapPanel Margin="8,10,8,4">
                            <Button x:Name="ClearDNS" Style="{StaticResource ToolButtonStyle}" Click="ClearDNS_Click"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE968;" FontFamily="{DynamicResource SegoeIcons}" FontSize="24"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{model:Resource Key=WinUtil_ClearDNS}" FontSize="12" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ResetWS" Style="{StaticResource ToolButtonStyle}" Click="ResetWS_Click"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE969;" FontFamily="{DynamicResource SegoeIcons}" FontSize="24"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{model:Resource Key=WinUtil_ResetWinsock}" FontSize="12" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ResetWS_LSP" Style="{StaticResource ToolButtonStyle}" Click="ResetWS_LSP_Click"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE969;" FontFamily="{DynamicResource SegoeIcons}" FontSize="24"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{model:Resource Key=WinUtil_ResetLSP}" FontSize="12" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ResetTCP" Style="{StaticResource ToolButtonStyle}" Click="ResetTCP_Click"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE96A;" FontFamily="{DynamicResource SegoeIcons}" FontSize="24"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{model:Resource Key=WinUtil_ResetTCP}" FontSize="12" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Expander.Content>
                </Expander>

                <!-- ═══════════════════════ Explorer功能 ═══════════════════════ -->
                <Expander Header="{model:Resource Key=WinUtil_ExplorerFeatures}" IsExpanded="True" FontSize="17"
                          Style="{StaticResource {x:Static muxc:ThemeKeys.ExpanderCardStyleKey}}"
                          Margin="0,0,0,10" Padding="0">
                    <Expander.Content>
                        <StackPanel>
                            <WrapPanel Margin="8,10,8,4">
                                <ToggleButton x:Name="ShowFileExt" Style="{StaticResource ToolToggleStyle}" 
                                              Checked="ShowFileExt_Toggled" Unchecked="ShowFileExt_Toggled"
                                              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock x:Name="ShowFileExtIcon" Text="&#xE8A7;" FontFamily="{DynamicResource SegoeIcons}" FontSize="24"
                                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{model:Resource Key=WinUtil_ShowFileExt}" FontSize="12" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="ShowHidden" Style="{StaticResource ToolToggleStyle}"
                                              Checked="ShowHidden_Toggled" Unchecked="ShowHidden_Toggled"
                                              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8B9;" FontFamily="{DynamicResource SegoeIcons}" FontSize="24"
                                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{model:Resource Key=WinUtil_ShowHidden}" FontSize="12" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="ShowSuper" Style="{StaticResource ToolToggleStyle}"
                                              Checked="ShowSuper_Toggled" Unchecked="ShowSuper_Toggled"
                                              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE943;" FontFamily="{DynamicResource SegoeIcons}" FontSize="24"
                                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{model:Resource Key=WinUtil_ShowSuperHidden}" FontSize="12" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="HideArrow" Style="{StaticResource ToolToggleStyle}"
                                              Checked="HideArrow_Toggled" Unchecked="HideArrow_Toggled"
                                              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE76C;" FontFamily="{DynamicResource SegoeIcons}" FontSize="24"
                                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{model:Resource Key=WinUtil_HideArrow}" FontSize="12" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="HideText" Style="{StaticResource ToolToggleStyle}"
                                              Checked="HideText_Toggled" Unchecked="HideText_Toggled"
                                              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE756;" FontFamily="{DynamicResource SegoeIcons}" FontSize="24"
                                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{model:Resource Key=WinUtil_HideText}" FontSize="12" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="HideUAC" Style="{StaticResource ToolToggleStyle}"
                                              Checked="HideUAC_Toggled" Unchecked="HideUAC_Toggled"
                                              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE72E;" FontFamily="{DynamicResource SegoeIcons}" FontSize="24"
                                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{model:Resource Key=WinUtil_HideUAC}" FontSize="12" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                            </WrapPanel>
                            <WrapPanel Margin="12,0,8,12">
                                <Border BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="4,4,4,0"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{model:Resource Key=WinUtil_ContextMenuStyle}" FontSize="13"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox x:Name="MenuStyle" FontSize="14"
                                                  Width="120" SelectionChanged="MenuStyle_SelectionChanged">
                                            <ComboBoxItem Content="{model:Resource Key=WinUtil_MenuStyle_Win10}"/>
                                            <ComboBoxItem Content="{model:Resource Key=WinUtil_MenuStyle_Win11}"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                                <Border BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="4,4,4,0"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{model:Resource Key=WinUtil_ExplorerDefault}" FontSize="13"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox x:Name="ExplorerDefault" FontSize="14"
                                                  Width="120" SelectionChanged="ExplorerDefault_SelectionChanged">
                                            <ComboBoxItem Content="{model:Resource Key=WinUtil_Explorer_ThisPC}"/>
                                            <ComboBoxItem Content="{model:Resource Key=WinUtil_Explorer_QuickAccess}"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </Expander.Content>
                </Expander>

                <!-- ═══════════════════════ 性能设置 ═══════════════════════ -->
                <Expander Header="{model:Resource Key=WinUtil_Performance}" IsExpanded="True" FontSize="17"
                          Style="{StaticResource {x:Static muxc:ThemeKeys.ExpanderCardStyleKey}}"
                          Margin="0,0,0,10" Padding="0">
                    <Expander.Content>
                        <StackPanel>
                            <WrapPanel Margin="8,10,8,4">
                                <Button x:Name="PowerSetting" Style="{StaticResource ToolButtonStyle}" Click="PowerSetting_Click"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE7FC;" FontFamily="{DynamicResource SegoeIcons}" FontSize="24"
                                                   HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{model:Resource Key=WinUtil_PowerPlan}" FontSize="12" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="PowerOptions" Style="{StaticResource ToolButtonStyle}" Click="PowerOptions_Click"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE7FC;" FontFamily="{DynamicResource SegoeIcons}" FontSize="24"
                                                   HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{model:Resource Key=WinUtil_PowerPlanEdit}" FontSize="12" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="Advanced" Style="{StaticResource ToolButtonStyle}" Click="Advanced_Click"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE946;" FontFamily="{DynamicResource SegoeIcons}" FontSize="24"
                                                   HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{model:Resource Key=WinUtil_AdvancedSystem}" FontSize="12" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="Performance" Style="{StaticResource ToolButtonStyle}" Click="Performance_Click"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xEDA6;" FontFamily="{DynamicResource SegoeIcons}" FontSize="24"
                                                   HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{model:Resource Key=WinUtil_PerformanceOptions}" FontSize="12" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                            <WrapPanel Margin="12,0,8,12">
                                <Border BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="4,4,4,0"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{model:Resource Key=WinUtil_PowerScheme}" FontSize="13"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox x:Name="PowerConfig" FontSize="14" Width="120"
                                                  SelectionChanged="PowerConfig_SelectionChanged">
                                            <ComboBoxItem Content="{model:Resource Key=WinUtil_Power_Saver}"/>
                                            <ComboBoxItem Content="{model:Resource Key=WinUtil_Power_Balanced}"/>
                                            <ComboBoxItem Content="{model:Resource Key=WinUtil_Power_Performance}"/>
                                            <ComboBoxItem Content="{model:Resource Key=WinUtil_Power_Ultimate}"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </Expander.Content>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>