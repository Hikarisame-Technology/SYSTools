<Page x:Class="SYSTools.ToolPages.UncategorizedTools"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:muxc="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:local="clr-namespace:SYSTools.ToolPages"
      xmlns:model="clr-namespace:SYSTools.Model"
      mc:Ignorable="d" 
      d:DesignWidth="1040" d:DesignHeight="560"
      KeepAlive="True"
      Title="UncategorizedTools" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  MinWidth="1040" MinHeight="560" Loaded="Page_Loaded">
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <ScrollViewer  VerticalScrollBarVisibility="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <!--按钮固定上下大小66(px?)-->
                <TextBlock Text="该页工具存放于'应用根目录/Software Package/UncategorizedTools/'文件夹内(鼠标右键点击这条文字可打开文件夹)       下列工具请单击打开" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,5,0,0" FontSize="10" Height="13" MouseRightButtonDown="TextBlock_MouseRightButtonDown"/>
                
                <Button x:Name="SnappyDriverInstaller" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinWidth="1030" MinHeight="66" Margin="5,5,5,0" HorizontalContentAlignment="Left" Click="SnappyDriverInstaller_Click" Background="Transparent" >
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Image Source="/SYSTools;component/Resources/Icon/UncategorizedToolsICON/SDI.png" Width="50" Height="50" Margin="0,0,20,0"/>
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                            <TextBlock Text="Snappy Driver Installer" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="15"/>
                            <TextBlock Text="{model:Resource Key=SDI_Text}" VerticalAlignment="Bottom" HorizontalAlignment="Left" FontSize="10" Height="13"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button x:Name="Rufus" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinWidth="1030" MinHeight="66" Margin="5,5,5,0" HorizontalContentAlignment="Left" Click="Rufus_Click" Background="Transparent" >
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Image Source="/SYSTools;component/Resources/Icon/UncategorizedToolsICON/Rufus.png" Width="50" Height="50" Margin="0,0,20,0"/>
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                            <TextBlock Text="Rufus" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="15"/>
                            <TextBlock Text="{model:Resource Key=Rufus_Text}" VerticalAlignment="Bottom" HorizontalAlignment="Left" FontSize="10" Height="13"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button x:Name="Etcher" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinWidth="1030" MinHeight="66" Margin="5,5,5,0" HorizontalContentAlignment="Left" Click="Etcher_Click" Background="Transparent" >
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Image Source="/SYSTools;component/Resources/Icon/UncategorizedToolsICON/Etcher.png" Width="50" Height="50" Margin="0,0,20,0"/>
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                            <TextBlock Text="Etcher" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="15"/>
                            <TextBlock Text="{model:Resource Key=Etcher_Text}" VerticalAlignment="Bottom" HorizontalAlignment="Left" FontSize="10" Height="13"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button x:Name="Ventoy" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinWidth="1030" MinHeight="66" Margin="5,5,5,0" HorizontalContentAlignment="Left" Click="Ventoy_Click" Background="Transparent" >
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Image Source="/SYSTools;component/Resources/Icon/UncategorizedToolsICON/Ventoy.png" Width="50" Height="50" Margin="0,0,20,0"/>
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                            <TextBlock Text="Ventoy" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="15"/>
                            <TextBlock Text="{model:Resource Key=Ventoy_Text}" VerticalAlignment="Bottom" HorizontalAlignment="Left" FontSize="10" Height="13"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>