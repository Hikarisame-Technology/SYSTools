<Page x:Class="SYSTools.ToolPages.DiskTools"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:muxc="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:local="clr-namespace:SYSTools.ToolPages"
      xmlns:model="clr-namespace:SYSTools.Model"
      mc:Ignorable="d" 
      d:DesignWidth="1040" d:DesignHeight="560"
      KeepAlive="True"
      Title="DiskTools" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  MinWidth="1040" MinHeight="560" Loaded="Page_Loaded">
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <ScrollViewer  VerticalScrollBarVisibility="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <TextBlock Text="该页工具存放于'应用根目录/Software Package/DiskTools/'文件夹内(鼠标右键点击这条文字可打开文件夹)       下列工具请单击打开" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,5,0,0" FontSize="10" Height="13" MouseRightButtonDown="TextBlock_MouseRightButtonDown"/>
                <!--按钮固定上下大小66(px?)-->
                <Button x:Name="AS_SSD" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinWidth="1015" MinHeight="66" Margin="5,5,20,0" HorizontalContentAlignment="Left" Click="AS_SSD_Click" Background="{x:Null}">
                    <TextBlock><InlineUIContainer>
                            <Image Source="/SYSTools;component/Resources/Icon/DiskToolsICON/AS SSD.png" Width="50" Height="50"/>
                        </InlineUIContainer><Run Text=" "/><Run Text=" "/><InlineUIContainer>
                            <TextBlock Text="AS SSD" VerticalAlignment="Top" Margin="20,-26,0,0" HorizontalAlignment="Left" FontSize="15" Width="142"/>
                        </InlineUIContainer><Run Text=" "/><InlineUIContainer>
                            <TextBlock Text="{model:Resource Key=AS-SSD_Text}" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="-146,-11,0,0" FontSize="10" Height="13"/>
                        </InlineUIContainer>

                    </TextBlock>
                </Button>
                <Button x:Name="CrystalDiskInfo" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinWidth="1015" MinHeight="66" Margin="5,5,20,0" HorizontalContentAlignment="Left" Click="CrystalDiskInfo_Click" Background="{x:Null}">
                    <TextBlock><InlineUIContainer>
                            <Image Source="/SYSTools;component/Resources/Icon/DiskToolsICON/CrystalDiskInfo.png" Width="50" Height="50"/>
                        </InlineUIContainer><Run Text=" "/><Run Text=" "/><InlineUIContainer>
                            <TextBlock Text="CrystalDiskInfo" VerticalAlignment="Top" Margin="20,-26,0,0" HorizontalAlignment="Left" FontSize="15" Width="142"/>
                        </InlineUIContainer><Run Text=" "/><InlineUIContainer>
                            <TextBlock Text="{model:Resource Key=CrystalDiskInfo_Text}" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="-146,-11,0,0" FontSize="10" Height="13"/>
                        </InlineUIContainer>

                    </TextBlock>
                </Button>
                <Button x:Name="CrystalDiskMark" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinWidth="1015" MinHeight="66" Margin="5,5,20,0" HorizontalContentAlignment="Left" Click="CrystalDiskMark_Click" Background="{x:Null}">
                    <TextBlock><InlineUIContainer>
                            <Image Source="/SYSTools;component/Resources/Icon/DiskToolsICON/CrystalDiskMark.png" Width="50" Height="50"/>
                        </InlineUIContainer><Run Text=" "/><Run Text=" "/><InlineUIContainer>
                            <TextBlock Text="CrystalDiskMark" VerticalAlignment="Top" Margin="20,-26,0,0" HorizontalAlignment="Left" FontSize="15" Width="142"/>
                        </InlineUIContainer><Run Text=" "/><InlineUIContainer>
                            <TextBlock Text="{model:Resource Key=CrystalDiskMark_Text}" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="-146,-11,0,0" FontSize="10" Height="13"/>
                        </InlineUIContainer>

                    </TextBlock>
                </Button>
                <Button x:Name="DiskBenchmark" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinWidth="1015" MinHeight="66" Margin="5,5,20,0" HorizontalContentAlignment="Left" Click="DiskBenchmark_Click" Background="{x:Null}">
                    <TextBlock><InlineUIContainer>
                            <Image Source="/SYSTools;component/Resources/Icon/DiskToolsICON/Disk Benchmark.png" Width="50" Height="50"/>
                        </InlineUIContainer><Run Text=" "/><Run Text=" "/><InlineUIContainer>
                            <TextBlock Text="Disk Benchmark" VerticalAlignment="Top" Margin="20,-26,0,0" HorizontalAlignment="Left" FontSize="15" Width="142"/>
                        </InlineUIContainer><Run Text=" "/><InlineUIContainer>
                            <TextBlock Text="{model:Resource Key=DiskBenchmark_Text}" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="-146,-11,0,0" FontSize="10" Height="13"/>
                        </InlineUIContainer>

                    </TextBlock>
                </Button>
                <Button x:Name="DiskGenius" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinWidth="1015" MinHeight="66" Margin="5,5,20,0" HorizontalContentAlignment="Left" Click="DiskGenius_Click" Background="{x:Null}">
                    <TextBlock><InlineUIContainer>
                            <Image Source="/SYSTools;component/Resources/Icon/DiskToolsICON/DiskGenius.png" Width="50" Height="50"/>
                        </InlineUIContainer><Run Text=" "/><Run Text=" "/><InlineUIContainer>
                            <TextBlock Text="DiskGenius" VerticalAlignment="Top" Margin="20,-26,0,0" HorizontalAlignment="Left" FontSize="15" Width="142"/>
                        </InlineUIContainer><Run Text=" "/><InlineUIContainer>
                            <TextBlock Text="{model:Resource Key=DiskGenius_Text}" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="-146,-11,0,0" FontSize="10" Height="13"/>
                        </InlineUIContainer>

                    </TextBlock>
                </Button>
                <Button x:Name="HDTune" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinWidth="1015" MinHeight="66" Margin="5,5,20,0" HorizontalContentAlignment="Left" Click="HDTune_Click" Background="{x:Null}">
                    <TextBlock><InlineUIContainer>
                            <Image Source="/SYSTools;component/Resources/Icon/DiskToolsICON/HD Tune.png" Width="50" Height="50"/>
                        </InlineUIContainer><Run Text=" "/><Run Text=" "/><InlineUIContainer>
                            <TextBlock Text="HD Tune" VerticalAlignment="Top" Margin="20,-26,0,0" HorizontalAlignment="Left" FontSize="15" Width="142"/>
                        </InlineUIContainer><Run Text=" "/><InlineUIContainer>
                            <TextBlock Text="{model:Resource Key=HDTune_Text}" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="-146,-11,0,0" FontSize="10" Height="13"/>
                        </InlineUIContainer>

                    </TextBlock>
                </Button>
                <Button x:Name="LLFTOOL" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinWidth="1015" MinHeight="66" Margin="5,5,20,0" HorizontalContentAlignment="Left" Click="LLFTOOL_Click" Background="{x:Null}">
                    <TextBlock><InlineUIContainer>
                            <Image Source="/SYSTools;component/Resources/Icon/DiskToolsICON/LLFTOOL.png" Width="50" Height="50"/>
                        </InlineUIContainer><Run Text=" "/><Run Text=" "/><InlineUIContainer>
                            <TextBlock Text="LLFTOOL" VerticalAlignment="Top" Margin="20,-26,0,0" HorizontalAlignment="Left" FontSize="15" Width="142"/>
                        </InlineUIContainer><Run Text=" "/><InlineUIContainer>
                            <TextBlock Text="{model:Resource Key=LLFTOOL_Text}" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="-146,-11,0,0" FontSize="10" Height="13"/>
                        </InlineUIContainer>

                    </TextBlock>
                </Button>
                <Button x:Name="PartAssist" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinWidth="1015" MinHeight="66" Margin="5,5,20,0" HorizontalContentAlignment="Left" Click="PartAssist_Click" Background="{x:Null}">
                    <TextBlock><InlineUIContainer>
                            <Image Source="/SYSTools;component/Resources/Icon/DiskToolsICON/PartAssist.png" Width="50" Height="50"/>
                        </InlineUIContainer><Run Text=" "/><Run Text=" "/><InlineUIContainer>
                            <TextBlock Text="PartAssist" VerticalAlignment="Top" Margin="20,-26,0,0" HorizontalAlignment="Left" FontSize="15" Width="142"/>
                        </InlineUIContainer><Run Text=" "/><InlineUIContainer>
                            <TextBlock Text="{model:Resource Key=PartAssist_Text}" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="-146,-11,0,0" FontSize="10" Height="13"/>
                        </InlineUIContainer>

                    </TextBlock>
                </Button>
                <Button x:Name="SSDZ" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinWidth="1015" MinHeight="66" Margin="5,5,20,0" HorizontalContentAlignment="Left" Click="SSDZ_Click" Background="{x:Null}">
                    <TextBlock><InlineUIContainer>
                            <Image Source="/SYSTools;component/Resources/Icon/DiskToolsICON/SSD-Z.png" Width="50" Height="50"/>
                        </InlineUIContainer><Run Text=" "/><Run Text=" "/><InlineUIContainer>
                            <TextBlock Text="SSD-Z" VerticalAlignment="Top" Margin="20,-26,0,0" HorizontalAlignment="Left" FontSize="15" Width="142"/>
                        </InlineUIContainer><Run Text=" "/><InlineUIContainer>
                            <TextBlock Text="{model:Resource Key=SSD-Z_Text}" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="-146,-11,0,0" FontSize="10" Height="13"/>
                        </InlineUIContainer>

                    </TextBlock>
                </Button>
                <Button x:Name="Victoria" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinWidth="1015" MinHeight="66" Margin="5,5,20,0" HorizontalContentAlignment="Left" Click="Victoria_Click" Background="{x:Null}">
                    <TextBlock><InlineUIContainer>
                            <Image Source="/SYSTools;component/Resources/Icon/DiskToolsICON/Victoria.png" Width="50" Height="50"/>
                        </InlineUIContainer><Run Text=" "/><Run Text=" "/><InlineUIContainer>
                            <TextBlock Text="Victoria" VerticalAlignment="Top" Margin="20,-26,0,0" HorizontalAlignment="Left" FontSize="15" Width="142"/>
                        </InlineUIContainer><Run Text=" "/><InlineUIContainer>
                            <TextBlock Text="{model:Resource Key=Victoria_Text}" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="-146,-11,0,0" FontSize="10" Height="13"/>
                        </InlineUIContainer>

                    </TextBlock>
                </Button>
                <Button x:Name="H2TestW" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinWidth="1015" MinHeight="66" Margin="5,5,20,5" HorizontalContentAlignment="Left" Click="H2TestW_Click" Background="{x:Null}">
                    <TextBlock><InlineUIContainer>
                            <Image Source="/SYSTools;component/Resources/Icon/DiskToolsICON/H2TestW.png" Width="50" Height="50"/>
                        </InlineUIContainer><Run Text=" "/><Run Text=" "/><InlineUIContainer>
                            <TextBlock Text="H2TestW" VerticalAlignment="Top" Margin="20,-26,0,0" HorizontalAlignment="Left" FontSize="15" Width="142"/>
                        </InlineUIContainer><Run Text=" "/><InlineUIContainer>
                            <TextBlock Text="{model:Resource Key=H2TestW_Text}" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="-146,-11,0,0" FontSize="10" Height="13"/>
                        </InlineUIContainer>

                    </TextBlock>
                </Button>


            </StackPanel>
        </ScrollViewer>
    </Grid>
    
</Page>
