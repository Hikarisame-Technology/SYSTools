<Page x:Class="SYSTools.Pages.CustomTool"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:muxc="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:model="clr-namespace:SYSTools.Model"
      xmlns:local="clr-namespace:SYSTools.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="610" d:DesignWidth="1040"
      KeepAlive="True"
      Title="CustomTool" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinWidth="1040" MinHeight="610" Loaded="Page_Loaded"
      AllowDrop="True"
      Drop="MainGrid_Drop"
      DragLeave="MainGrid_DragLeave"
      DragOver="MainGrid_DragOver"
      PreviewDragOver="MainGrid_DragOver"
      PreviewDrop="MainGrid_Drop">

    <Page.Resources>
        <!-- 拖拽时的样式 -->
        <Style x:Key="DragDropBorderStyle" TargetType="Border">
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#FF007ACC"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid x:Name="MainGrid" 
          AllowDrop="True"
          Drop="MainGrid_Drop"
          DragLeave="MainGrid_DragLeave"
          DragOver="MainGrid_DragOver"
          Background="Transparent">
        
        <Image x:Name="image" HorizontalAlignment="Right" VerticalAlignment="Bottom" Grid.Column="1" Grid.Row="3" Source="/SYSTools;component/Resources/LOGO.png" Opacity="0.5" Width="160" Height="90"/>

        <TextBlock Margin="20,17,0,0" TextWrapping="Wrap" Text="{model:Resource Key=CustomTool_TextBlock}" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="20" UseLayoutRounding="True"/>

        <Button x:Name="AddToolButton" Content="{model:Resource Key=AddNewTool}" Command="{Binding AddToolCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,13.5,35,0" MinWidth="70" FontSize="15" MinHeight="32.05" IsTabStop="False" Background="{x:Null}" BorderBrush="#33000000"/>

        <Border BorderBrush="#CC202020" BorderThickness="1" CornerRadius="5" Margin="10,60,10,10">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ToolItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <Border Padding="40,15,40,15" Margin="5" CornerRadius="5" BorderThickness="1" BorderBrush="#CC202020" Background="{DynamicResource {x:Static muxc:ThemeKeys.ButtonBorderBrushKey}}" Width="160" Height="170"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}"
                                    Style="{StaticResource DragDropBorderStyle}"
                                    MouseLeftButtonDown="ToolItem_MouseLeftButtonDown"
                                    MouseMove="ToolItem_MouseMove"
                                    MouseLeftButtonUp="ToolItem_MouseLeftButtonUp">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{model:Resource Key=Modify}"
                                                  Command="{Binding PlacementTarget.Tag.EditToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="{model:Resource Key=Delete}"
                                                  Command="{Binding PlacementTarget.Tag.DeleteToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <StackPanel>
                                    <Image Source="{Binding IconSource}" Width="80" Height="80" IsHitTestVisible="False"/>
                                    <TextBlock Text="{Binding Name}" Margin="0,5,0,0" HorizontalAlignment="Center"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="80"
                                               ToolTip="{Binding Name}" IsHitTestVisible="False"/>
                                    <Button Content="{model:Resource Key=Open}" Command="{Binding LaunchCommand}" Margin="0,5,0,5" HorizontalAlignment="Stretch" VerticalAlignment="Top" Background="{x:Null}" BorderBrush="#33000000"/>
                                </StackPanel>
                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        
    </Grid>
</Page>

