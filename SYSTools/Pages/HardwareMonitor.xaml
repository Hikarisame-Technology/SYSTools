<Page x:Class="SYSTools.Pages.HardwareMonitor"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:muxc="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:model="clr-namespace:SYSTools.Model"
      xmlns:local="clr-namespace:SYSTools.Pages"
      mc:Ignorable="d" 
      KeepAlive="True"
      d:DesignHeight="610" d:DesignWidth="1040"
      Title="HardwareMonitor" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinWidth="1040" MinHeight="610">
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Image x:Name="image" HorizontalAlignment="Right" VerticalAlignment="Bottom" Source="/SYSTools;component/Resources/LOGO.png" Opacity="0.5" Height="90" Width="160"/>
        <Border BorderThickness="1" CornerRadius="5" Grid.RowSpan="3" Grid.ColumnSpan="2"/>
        <TextBlock Margin="20,17,0,0" TextWrapping="Wrap" Text="{model:Resource Key=HardwareMonitor_TextBlock}" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="20" UseLayoutRounding="True"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,13.5,10,0">
            <TextBlock x:Name="RefreshStatusText" Text="自动刷新: 2s" FontSize="13" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Button x:Name="RefreshButton" Content="&#xE72C;" FontFamily="{DynamicResource SegoeIcons}" ToolTip="立即刷新" MinWidth="40" FontSize="16" MinHeight="32.05" IsTabStop="False" Click="RefreshButton_Click" Background="{x:Null}" BorderBrush="#33000000"/>
        </StackPanel>
        <Border BorderBrush="#CC202020" BorderThickness="1" CornerRadius="5" Margin="10,60,10,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="15">
                <Grid x:Name="MainPanel" HorizontalAlignment="Stretch">
                    <!-- 动态创建列 -->
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>