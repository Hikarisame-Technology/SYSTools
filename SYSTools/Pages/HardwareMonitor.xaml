<Page x:Class="SYSTools.Pages.HardwareMonitor"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:muxc="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:model="clr-namespace:SYSTools.Model"
      xmlns:local="clr-namespace:SYSTools.Pages"
      mc:Ignorable="d" 
      KeepAlive="True"
      d:DesignHeight="610" d:DesignWidth="1040"
      Title="Test" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinWidth="1040" MinHeight="610">

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

        <Image x:Name="image" HorizontalAlignment="Right" VerticalAlignment="Bottom" Source="/SYSTools;component/Resources/LOGO.png" Opacity="0.5" Height="90" Width="160"/>

        <Border  BorderThickness="1" CornerRadius="5" Grid.RowSpan="3" Grid.ColumnSpan="2"/>

        <TextBlock Margin="20,17,0,0" TextWrapping="Wrap" Text="{model:Resource Key=HardwareMonitor_TextBlock}" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="20" UseLayoutRounding="True"/>

        <Button x:Name="CollapseAllButton" Content="{model:Resource Key=CollapseAll}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,13.5,35,0" MinWidth="70" FontSize="15" MinHeight="32.05" IsTabStop="False" Click="CollapseAllButton_Click" Background="{x:Null}" BorderBrush="#33000000"/>
        <Button x:Name="ExpandAllButton" Content="{model:Resource Key=ExpandAll}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,13.5,155,0" MinWidth="70" FontSize="15" MinHeight="32.05" IsTabStop="False" Click="ExpandAllButton_Click" Background="{x:Null}" BorderBrush="#33000000"/>

        <Border BorderBrush="#CC202020" BorderThickness="1" CornerRadius="5" Margin="10,60,10,10">
            <TreeView x:Name="TestView" IsTabStop="False" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderThickness="0" >
            </TreeView>
        </Border>

    </Grid>
</Page>
